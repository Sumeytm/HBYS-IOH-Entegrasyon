          <script>var rawMessage = connectorMessage.getRawData();
var iohData = JSON.parse(rawMessage);
var statusMap = {
    &apos;completed&apos;: &apos;TAMAMLANDI&apos;,
    &apos;pending&apos;: &apos;BEKLEMEDE&apos;,
    &apos;error&apos;: &apos;HATALI&apos;,
    &apos;cancelled&apos;: &apos;IPTAL&apos;
};
function formatDate(dateString) {
    if (!dateString) return null;
    var d = new Date(dateString);
    var pad = function(n) { return n &lt; 10 ? &apos;0&apos; + n : n; };
    return d.getFullYear() + &apos;-&apos; + pad(d.getMonth() + 1) + &apos;-&apos; + pad(d.getDate()) +
           &apos; &apos; + pad(d.getHours()) + &apos;:&apos; + pad(d.getMinutes()) + &apos;:&apos; + pad(d.getSeconds());
}
if (!iohData.patientId || !iohData.testCode) {
    logger.error(&apos;[HBYS_Result_Channel] HATA - Zorunlu alan eksik | mesajId=&apos; + connectorMessage.getMessageId() +
                 &apos; | hamVeri=&apos; + rawMessage);
    throw new Error(&apos;Mapping hatasi: zorunlu alanlar eksik&apos;);
}
var hbysData = {
    sonucId: iohData.id,
    hastaId: iohData.patientId,
    testKodu: iohData.testCode,
    sonucDegeri: iohData.value,
    birim: iohData.unit || &apos;&apos;,
    islemDurumu: statusMap[(iohData.status || &apos;&apos;).toLowerCase()] || &apos;BILINMIYOR&apos;,
    sonucTarihi: formatDate(iohData.resultDate),
    kaynakSistem: &apos;IOH&apos;
};
channelMap.put(&apos;hbysPayload&apos;, JSON.stringify(hbysData));
logger.info(&apos;[HBYS_Result_Channel] Mesaj basariyla donusturuldu | mesajId=&apos; + connectorMessage.getMessageId() +
